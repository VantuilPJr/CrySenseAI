4:textId="77777777" w:rsidR="0016034C" w:rsidRPr="0016034C" w:rsidRDefault="0016034C" w:rsidP="0016034C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="22"/></w:numPr></w:pPr><w:r w:rsidRPr="0016034C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Documentação Acadêmica (ABNT) – 10%</w:t></w:r><w:r w:rsidRPr="0016034C"><w:br/><w:t>Estrutura acadêmica, descrição de testes e conformidade integral com ABNT.</w:t></w:r></w:p><w:p w14:paraId="08AF435E" w14:textId="77777777" w:rsidR="0016034C" w:rsidRPr="0016034C" w:rsidRDefault="0016034C" w:rsidP="0016034C"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="22"/></w:numPr></w:pPr><w:r w:rsidRPr="0016034C"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Defesa e Originalidade do Projeto – Critério Eliminatório</w:t></w:r><w:r w:rsidRPr="0016034C"><w:br/><w:t>Capacidade de defender tecnicamente o projeto, demonstrar domínio do sistema e evidenciar originalidade. A reprodução direta de tutoriais, ausência de autoria intelectual ou incapacidade de justificar decisões técnicas pode resultar em reprovação, independentemente da pontuação obtida.</w:t></w:r></w:p><w:p w14:paraId="61761731" w14:textId="77777777" w:rsidR="005E7786" w:rsidRDefault="005E7786" w:rsidP="0016034C"/><w:p w14:paraId="6783F445" w14:textId="77777777" w:rsidR="005E7786" w:rsidRPr="005E7786" w:rsidRDefault="005E7786" w:rsidP="005E7786"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="73517EB5" w14:textId="77777777" w:rsidR="005E7786" w:rsidRPr="005E7786" w:rsidRDefault="005E7786" w:rsidP="005E7786"/><w:sectPr w:rsidR="005E7786" w:rsidRPr="005E7786" w:rsidSect="005E7786"><w:headerReference w:type="default" r:id="rId11"/><w:footerReference w:type="default" r:id="rId12"/><w:pgSz w:w="11901" w:h="16840" w:code="9"/><w:pgMar w:top="720" w:right="1269" w:bottom="720" w:left="1276" w:header="709" w:footer="709" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>